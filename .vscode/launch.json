{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Server",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/server",
      "program": "${workspaceFolder}/server/src/index.ts",
      // tsx runs TypeScript directly; the "source" condition resolves @labyrinth/rules
      // to its .ts files, so breakpoints in packages/rules work too.
      "runtimeArgs": ["--import", "tsx", "--conditions=source"],
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"],
      "console": "integratedTerminal"
    },
    {
      "name": "Client",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/client",
      "preLaunchTask": "client: dev"
    }
  ],
  "compounds": [
    {
      "name": "Full stack",
      "configurations": ["Server", "Client"],
      "stopAll": true
    }
  ]
}
