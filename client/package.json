{
  "name": "@labyrinth/client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "size": "size-limit",
    "icons": "pwa-assets-generator"
  },
  "dependencies": {
    "@colyseus/sdk": "^0.18.4",
    "@labyrinth/protocol": "*",
    "@labyrinth/rules": "*",
    "@tabler/icons-react": "^3.48.0",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.0",
    "pino": "^10.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-error-boundary": "^6.1.6",
    "react-i18next": "^17.0.15"
  },
  "devDependencies": {
    "@size-limit/file": "^14.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vite-pwa/assets-generator": "^1.0.4",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^29.1.1",
    "size-limit": "^14.0.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.2"
  },
  "size-limit": [
    {
      "name": "client JavaScript (gzip)",
      "path": "dist/assets/*.js",
      "limit": "200 kB",
      "gzip": true
    }
  ]
}
