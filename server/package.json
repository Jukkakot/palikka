{
  "name": "@palikka/server",
  "version": "0.1.0",
  "private": true,
  "description": "Authoritative Colyseus game server for Palikka",
  "type": "module",
  "main": "build/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --conditions=source src/index.ts",
    "build": "rimraf build && tsc -p tsconfig.build.json && node -e \"require('fs').writeFileSync('build/build-info.json', JSON.stringify({ builtAt: new Date().toISOString() }))\"",
    "start": "node build/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@axiomhq/pino": "^2.0.0",
    "@colyseus/schema": "^5.0.34",
    "@colyseus/tools": "^0.18.4",
    "@game-kit/protocol": "https://github.com/Jukkakot/game-kit/releases/download/v0.1.0/game-kit-protocol-0.1.0.tgz",
    "@game-kit/server": "https://github.com/Jukkakot/game-kit/releases/download/v0.1.0/game-kit-server-0.1.0.tgz",
    "@palikka/protocol": "*",
    "@palikka/rules": "*",
    "colyseus": "^0.18.8",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "human-id": "^4.2.1",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@colyseus/sdk": "^0.18.4",
    "@colyseus/testing": "^0.18.6",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "pino-pretty": "^13.1.3",
    "rimraf": "^6.0.1",
    "tsx": "^4.21.0",
    "typescript": "~6.0.2",
    "vitest": "^5.0.2"
  }
}
