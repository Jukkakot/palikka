{
  "name": "@palikka/bots",
  "version": "0.1.0",
  "private": true,
  "description": "Palikka's bots: the rules adapter for the game-bots library and the evaluation",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bench": "tsx --conditions=source scripts/bench.ts"
  },
  "dependencies": {
    "@palikka/rules": "*",
    "game-bots": "*"
  },
  "devDependencies": {
    "typescript": "~6.0.2",
    "vitest": "^5.0.2"
  }
}
