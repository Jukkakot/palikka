{
  "name": "game-bots",
  "version": "0.1.0",
  "private": true,
  "description": "Game-independent bot brains: a game interface, budgets, greedy, best-reply search and MCTS players, a Web Worker harness, tournaments and Elo",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./worker": {
      "source": "./src/worker/index.ts",
      "types": "./dist/worker/index.d.ts",
      "default": "./dist/worker/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "~6.0.2",
    "vitest": "^5.0.2"
  }
}
