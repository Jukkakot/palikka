{
  "name": "@game-kit/server",
  "version": "0.1.0",
  "private": true,
  "description": "Game kit: the room base, the generic game room driven by the game contract, and server logging",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@axiomhq/pino": "^2.0.0",
    "@colyseus/schema": "^5.0.34",
    "@game-kit/protocol": "*",
    "colyseus": "^0.18.8",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "human-id": "^4.2.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@colyseus/sdk": "^0.18.4",
    "@colyseus/testing": "^0.18.6",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "typescript": "~6.0.2",
    "vitest": "^5.0.2"
  }
}
