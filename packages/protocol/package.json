{
  "name": "@palikka/protocol",
  "version": "0.1.0",
  "private": true,
  "description": "Client-server protocol definitions for Palikka: log events, message schemas, error codes",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@game-kit/protocol": "https://github.com/Jukkakot/game-kit/releases/download/v0.2.0/game-kit-protocol-0.2.0.tgz",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "typescript": "~6.0.2",
    "vitest": "^5.0.2"
  }
}
