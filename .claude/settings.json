{
  "permissions": {
    "allow": [
      "Bash(openspec list)",
      "Bash(openspec list *)",
      "Bash(openspec status *)",
      "Bash(openspec validate *)",
      "Bash(openspec instructions *)",
      "Bash(openspec show *)",
      "Bash(npm test)",
      "Bash(npm run typecheck)",
      "Bash(npm run lint)",
      "Bash(npm run size -w @palikka/client)",
      "Bash(npx vitest run)",
      "Bash(npx tsc --noEmit)",
      "Bash(npx oxlint)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/lint-edited.mjs\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
